# Copier ce fichier en .env.local (en local) ou saisir ces variables dans Hostinger.
# Ne jamais mettre les vraies clés dans le dépôt GitHub.

# Fournisseur d'IA : "groq" (gratuit, par défaut) ou "anthropic" (Claude, payant à l'usage)
AI_PROVIDER=groq

# Groq : clé à créer sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Claude (option payante) : clé à créer sur https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
